# copy-pipeline env var matrix.
#
# Copy to .env (which is gitignored) and fill in what you have. Each var is
# independent — missing keys degrade their component gracefully without
# crashing the pipeline. Inspect `--json` output for `rules_source` /
# variant-text fallback messages / `groundingChunks` to see what fell back.

# ── Model adapters (variant fan-out) ────────────────────────────────────────
# Set the keys for the providers in your brand-kit.models.candidates.
# Missing keys → that variant returns a placeholder with an explanatory
# message; pipeline continues with the others.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LLM voice judge ─────────────────────────────────────────────────────────
# The judge uses brand-kit.models.grader (e.g. claude-sonnet-4-6). Reads the
# same provider env vars above. Missing key → warning finding + neutral 0.5
# score; brand-review grader continues.

# ── Vertex AI Vector Search (corpus retrieval) ──────────────────────────────
# Required when any --ground corpus has status: "active" in brand-kit.
# Missing → grounding chunks are explanatory placeholders; pipeline runs
# without retrieved chunks in the prompt.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_VECTOR_SEARCH_ENDPOINT=

# ── Langfuse tracing ────────────────────────────────────────────────────────
# Point BASE_URL at a self-hosted Langfuse instance (e.g. via docker-compose
# at http://localhost:3004) or leave blank for Langfuse Cloud. Missing keys
# → no-op tracer, pipeline runs unchanged.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3004
# Optional filter tag — appears in trace name + searchable in UI.
LANGFUSE_RUN_LABEL=
